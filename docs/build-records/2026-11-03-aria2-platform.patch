+#ifndef MDO_DOWNLOAD_RANGE_H
+#define MDO_DOWNLOAD_RANGE_H
+#include <stdint.h>
+#include <string.h>
+typedef struct MdDownloadRange {uint64_t Offset,Bytes;unsigned Status;} MdDownloadRange;
+static int MdRangeNumber(const char** Cursor,uint64_t* Value){
+ const char* S=*Cursor;uint64_t N=0;if(*S<'0'||*S>'9')return 0;
+ for(;*S>='0'&&*S<='9';S++){if(N>(UINT64_MAX-(unsigned)(*S-'0'))/10)return 0;N=N*10+(unsigned)(*S-'0');}
+ *Cursor=S;*Value=N;return 1;
+}
+/* One ordinary byte range. No overflow, multipart allocation or date parsing.
+ * An unsupported/mismatched If-Range returns the complete representation. */
+static MdDownloadRange MdDownloadSelectRange(const char* Header,const char* IfRange,const char* Tag,uint64_t Size){
+ MdDownloadRange R={0,Size,200};if(!Header||!*Header||(IfRange&&*IfRange&&strcmp(IfRange,Tag)))return R;
+ R.Status=416;R.Bytes=0;if(strncmp(Header,"bytes=",6)||!Size)return R;const char* P=Header+6;uint64_t First=0,Last=0;
+ if(*P=='-'){
+  P++;if(!MdRangeNumber(&P,&Last)||!Last)return R;First=Last>=Size?0:Size-Last;Last=Size-1;
+ }else{
+  if(!MdRangeNumber(&P,&First)||*P++!='-'||First>=Size)return R;
+  if(*P>='0'&&*P<='9'){if(!MdRangeNumber(&P,&Last)||Last<First)return R;if(Last>=Size)Last=Size-1;}
+  else Last=Size-1;
+ }
+ while(*P==' '||*P=='\t')P++;if(*P)return R;
+ R.Offset=First;R.Bytes=Last-First+1;R.Status=206;return R;
+}
+#endif
