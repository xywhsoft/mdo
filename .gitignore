# 运行数据：模型配置（含 API key）、会话账本、记忆、审计与回收站——永不入库
data/
mdo-home/

# 构建产物与二进制
*.exe
*.apk
*.log
.build/
app/generated/
app/default-home/config/secrets/

# 运行时状态与临时文件
window-state-*.txt
.xrt-write-*.tmp
*.tmp
*.dmp
crash_*.txt
__pycache__/
*.pyc

