+typedef struct { char Host[256];unsigned Port;bool Tls; } XS_ProxyTarget;
+static bool XS_ProxyFailure(XS_SystemProxyInfo* R,cstr Why)
+{
+    R->Kind=XS_SYSTEM_PROXY_DIRECT;R->Port=0;R->Host[0]=R->User[0]=0;
