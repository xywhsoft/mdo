+        At=End;
+    }
+    bool Ok=UnversionedSocks?XS_ProxyFailure(R,"The system selected unversioned SOCKS; configure SOCKS5 manually"):!Best||XS_ProxyEndpoint(Selected,R);
+    xrtSecureZero(Selected,sizeof(Selected));return Ok;
+}
