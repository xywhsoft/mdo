+    typedef UINT (WINAPI* GetDpi)(HWND);GetDpi fn=NULL;FARPROC address=GetProcAddress(GetModuleHandleW(L"user32.dll"),"GetDpiForWindow");
+    if(address)memcpy(&fn,&address,sizeof(fn));
