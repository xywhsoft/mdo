+    if(FAILED(result))return 0;{std::lock_guard<std::mutex> lock(xb_hosts_mutex);xb_hosts[view]=host;}return 1;
+  }catch(...){return 0;}
+}
+extern "C" void xsWvDestroyBrowsers(void* view){
+  std::shared_ptr<xb_host> host;
