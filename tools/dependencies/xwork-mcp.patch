+bool xworkAgentSetMcpServers(xwork_agent* pAgent,
+    const char* const* psServerIds, size_t iCount, xwork_error* pError)
+{
+    char** psOwned = NULL;
+    size_t i;
+    if ( !pAgent || iCount > 256u ||
+         !xwork__mcp_string_array_copy(&psOwned, psServerIds, iCount) ) {
+        xwork__set_error(pError, XWORK_ERROR_INVALID_ARGUMENT, "invalid MCP server scope"); return false;
+    }
+    if ( !xrtMutexLock(pAgent->pStateLock) ) {
+        xwork__mcp_string_array_unit(psOwned, iCount);return false;
+    }
+    if ( pAgent->bRunning ) {
+        (void)xrtMutexUnlock(pAgent->pStateLock);
+        xwork__mcp_string_array_unit(psOwned, iCount);
+        xwork__set_error(pError, XWORK_ERROR_CONTEXT, "MCP scope cannot change during a run");return false;
+    }
+    for ( i = 0u; i < pAgent->iMcpServerScopeCount; ++i ) free(pAgent->psMcpServerScope[i]);
+    free(pAgent->psMcpServerScope);
+    pAgent->psMcpServerScope = psOwned;pAgent->iMcpServerScopeCount = iCount;
+    pAgent->bMcpServerScope = true;
+    (void)xrtMutexUnlock(pAgent->pStateLock);return true;
+}
