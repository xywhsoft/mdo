+    host->reply(id,std::string("{\"accepted\":true,\"trusted_input\":true,\"")+kind+"_open\":true}");
+  }
+  void dialogOpened(){boundary("dialog");}
+  void popupOpened(){boundary("popup");}
+  void run(){
