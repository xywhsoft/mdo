+            }
+        }
+        if(Binary||Result!=XWORK_EXPLORE_OK)break;
+    }
+    if(!Binary&&Result==XWORK_EXPLORE_OK&&Line.iLen) {
+        Result=xwork__explore_grep_log_line(File,State,Line.pData,Line.iLen,++LineNumber);
