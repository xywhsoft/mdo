+    size_t InlineBytes;
+    uint64_t MaxBytes;
+    uint64_t Stored;
+    bool FilesFromStart;
+    bool MergeStderr;
+    bool Finished;
+    bool Reserved;
+    struct xwork_process_output* ActiveNext;
+    xwork_output_stream Streams[2];
+};
