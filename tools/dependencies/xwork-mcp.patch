+    return !(Now>=0.0)?0u:Now>=(double)(UINT64_MAX-1u)?UINT64_MAX-1u:(uint64_t)Now;
+}
+static xdeadline mdo_xoauth_after(uint64_t Duration) {
+    uint64_t Now=mdo_xoauth_clock_us();
+    return Duration>=UINT64_MAX-Now?UINT64_MAX:Now+Duration;
+}
+static uint64_t mdo_xoauth_remaining(xdeadline Deadline) {
+    uint64_t Now=mdo_xoauth_clock_us();
+    return Deadline==UINT64_MAX?UINT64_MAX:Deadline>Now?Deadline-Now:0u;
+}
+static bool mdo_xoauth_expired(xdeadline Deadline) {
+    return Deadline!=UINT64_MAX&&mdo_xoauth_remaining(Deadline)==0u;
+}
+static xwaitresult mdo_xoauth_wait(xfuture* Future,uint64_t Microseconds) {
+    uint64_t Milliseconds=Microseconds/1000u+(Microseconds%1000u!=0u);
+    return xrtFutureWaitFor(Future,Microseconds==UINT64_MAX?XRT_WAIT_FOREVER:
+        Milliseconds>INT64_MAX?INT64_MAX:(int64_t)Milliseconds);
+}
+static int64_t mdo_xoauth_unix_us(void) {
+    return (xrtNow()-XRT_TIME_UNIX_EPOCH)*INT64_C(1000);
+}
+#define xrtDeadlineAfter mdo_xoauth_after
+#define xrtDeadlineRemaining mdo_xoauth_remaining
+#define xrtDeadlineExpired mdo_xoauth_expired
+#define xrtFutureWaitFor mdo_xoauth_wait
+#define xrtNow mdo_xoauth_unix_us
 #include "src/xoauth2_core.c"
 #include "src/xoauth2_flow.c"
 #include "src/xoauth2_http.c"
