+        while(Rules[At]&&(Rules[At]==','||Rules[At]==';'||Rules[At]==' '||Rules[At]=='\t'))At++;
+        size_t End=At;while(Rules[End]&&Rules[End]!=','&&Rules[End]!=';'&&Rules[End]!=' '&&Rules[End]!='\t')End++;
