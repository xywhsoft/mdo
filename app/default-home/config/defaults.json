{
  "schema_version": 1,
  "settings": {
    "locale": "zh-CN",
    "appearance": {
      "theme": "system",
      "font_size": "normal",
      "density": "comfortable"
    },
    "agent": {
      "interaction_mode": "agent",
      "reasoning_effort": "medium",
      "web_search": true,
      "memory": true,
      "schedules": true,
      "max_parallel_tools": 4,
      "max_parallel_subagents": 2
    },
    "workspace": {
      "open_mode": "last",
      "confirm_external_write": true
    }
  },
  "models": {
    "default_model": "ling-3.0-tiny",
    "providers": [
      {
        "id": "ling",
        "name": "Ling",
        "builtin": true,
        "editable": false,
        "removable": false,
        "verify_peer": true,
        "timeout_ms": 120000,
        "endpoints": {
          "chat_completions": "builtin:ling/openai/chat-completions",
          "responses": "builtin:ling/openai/responses",
          "anthropic_messages": "builtin:ling/anthropic/messages"
        },
        "credential": {
          "secret_ref": "env:MDO_LING_API_KEY"
        }
      }
    ],
    "items": [
      {
        "id": "ling-3.0-tiny",
        "name": "Ling 3.0 Tiny",
        "provider": "ling",
        "wire_model": "ling-3.0-tiny",
        "builtin": true,
        "free": true,
        "editable": false,
        "removable": false,
        "protocols": [
          "openai-chat-completions",
          "openai-responses",
          "anthropic-messages"
        ],
        "default_protocol": "openai-responses",
        "capabilities": [
          "text-input",
          "tool-result-input",
          "text-output",
          "json-output",
          "tool-call-output",
          "reasoning-output",
          "streaming",
          "reasoning-control",
          "parallel-tool-calls"
        ],
        "window": {
          "mode": "shared-context",
          "context_tokens": 131072,
          "max_input_tokens": 131071,
          "max_output_tokens": 16384,
          "output_reserve_tokens": 8192,
          "summary_tokens": 4096
        },
        "reasoning_efforts": ["none", "low", "medium", "high"],
        "default_reasoning_effort": "medium",
        "attachments": []
      }
    ]
  },
  "permissions": {
    "default_profile": "balanced",
    "profiles": {
      "read-only": {
        "workspace_read": true,
        "workspace_write": false,
        "process": "ask",
        "network": "ask"
      },
      "balanced": {
        "workspace_read": true,
        "workspace_write": "ask",
        "process": "ask",
        "network": "ask"
      },
      "full-access": {
        "workspace_read": true,
        "workspace_write": true,
        "process": true,
        "network": true
      }
    }
  }
}
