{
  "schema_version": 1,
  "settings": {
    "locale": "auto",
    "appearance": {
      "theme": "system",
      "font_size": "normal",
      "density": "comfortable"
    },
    "composer": {
      "submit_mode": "queue"
    },
    "notifications": {
      "sound": false
    },
    "power": {
      "prevent_sleep": false
    },
    "agent": {
      "reasoning_effort": "medium",
      "user_instructions": "",
      "reply_language": "",
      "web_search": true,
      "memory": true,
      "schedules": true,
      "max_turns": 0,
      "max_parallel_tools": 4,
      "max_parallel_subagents": 2
    },
    "web": {
      "allow_http": false,
      "allow_private_networks": false,
      "timeout_ms": 30000,
      "idle_timeout_ms": 10000,
      "max_response_bytes": 1048576,
      "max_text_bytes": 262144,
      "max_documents": 16
    },
    "transport": {
      "ca_pem_path": "",
      "proxy": {
        "kind": "none",
        "host": "",
        "port": 0,
        "user": "",
        "bypass": ""
      }
    },
    "workspace": {
      "open_mode": "last",
      "confirm_external_write": true
    }
  },
  "models": {
    "default_model": "",
    "providers": [],
    "items": []
  },
  "permissions": {
    "default_profile": "balanced",
    "profiles": {
      "read-only": {
        "workspace_read": true,
        "workspace_write": false,
        "process": "ask",
        "network": "ask"
      },
      "balanced": {
        "workspace_read": true,
        "workspace_write": "ask",
        "process": "ask",
        "network": "ask"
      },
      "full-access": {
        "workspace_read": true,
        "workspace_write": true,
        "process": true,
        "network": true
      }
    }
  }
}
