{
  "schema_version": 1,
  "settings": {
    "locale": "zh-CN",
    "appearance": {
      "theme": "system",
      "font_size": "normal",
      "density": "comfortable"
    },
    "composer": {
      "submit_mode": "queue"
    },
    "notifications": {
      "sound": false
    },
    "power": {
      "prevent_sleep": false
    },
    "agent": {
      "reasoning_effort": "medium",
      "user_instructions": "",
      "web_search": true,
      "memory": true,
      "schedules": true,
      "max_parallel_tools": 4,
      "max_parallel_subagents": 2
    },
    "web": {
      "enabled": true,
      "allow_http": false,
      "allow_private_networks": false,
      "timeout_ms": 30000,
      "idle_timeout_ms": 10000,
      "max_response_bytes": 1048576,
      "max_text_bytes": 262144,
      "max_documents": 16,
      "search": {
        "provider": "brave",
        "endpoint": "https://api.search.brave.com/res/v1/web/search",
        "secret_ref": "env:MDO_BRAVE_SEARCH_API_KEY",
        "max_results": 8
      }
    },
    "transport": {
      "ca_pem_path": "",
      "proxy": {
        "kind": "none",
        "host": "",
        "port": 0,
        "user": "",
        "bypass": ""
      }
    },
    "workspace": {
      "open_mode": "last",
      "confirm_external_write": true
    }
  },
  "models": {
    "default_model": "ornith-1.5-35b",
    "providers": [
      {
        "id": "ornith",
        "name": "Ornith",
        "builtin": true,
        "editable": false,
        "removable": false,
        "verify_peer": true,
        "timeout_ms": 120000,
        "endpoints": {
          "chat_completions": "builtin:ornith/openai/chat-completions",
          "responses": "builtin:ornith/openai/responses",
          "anthropic_messages": "builtin:ornith/anthropic/messages"
        },
        "credential": {
          "secret_ref": "env:MDO_ORNITH_API_KEY"
        }
      }
    ],
    "items": [
      {
        "id": "ornith-1.5-35b",
        "name": "ornith-1.5-35b",
        "provider": "ornith",
        "wire_model": "ornith-1.5-35b",
        "builtin": true,
        "free": true,
        "editable": false,
        "removable": false,
        "protocols": [
          "openai-chat-completions",
          "openai-responses",
          "anthropic-messages"
        ],
        "default_protocol": "openai-responses",
        "capabilities": [
          "text-input",
          "tool-result-input",
          "text-output",
          "json-output",
          "tool-call-output",
          "reasoning-output",
          "streaming",
          "reasoning-control",
          "parallel-tool-calls",
          "media-input"
        ],
        "window": {
          "mode": "shared-context",
          "context_tokens": 240128,
          "max_input_tokens": 240127,
          "max_output_tokens": 16384,
          "output_reserve_tokens": 8192,
          "summary_tokens": 4096
        },
        "reasoning_efforts": [
          "none",
          "low",
          "medium",
          "high"
        ],
        "default_reasoning_effort": "medium",
        "attachments": [
          "image"
        ]
      }
    ]
  },
  "permissions": {
    "default_profile": "balanced",
    "profiles": {
      "read-only": {
        "workspace_read": true,
        "workspace_write": false,
        "process": "ask",
        "network": "ask"
      },
      "balanced": {
        "workspace_read": true,
        "workspace_write": "ask",
        "process": "ask",
        "network": "ask"
      },
      "full-access": {
        "workspace_read": true,
        "workspace_write": true,
        "process": true,
        "network": true
      }
    }
  }
}
