{
  "services": [
    {
      "enabled": true,
      "class": "app",
      "name": "mdo",
      "ip": "127.0.0.1",
      "port": 0,
      "recv_limit": 104988672,
      "body_limit": 104873984,
      "host_default": {
        "enabled": true,
        "name": "mdo",
        "path": "web",
        "devlang": "c",
        "devfile": "generated/mdo_unity.c"
      },
      "window": {
        "title": "墨斗 mdo",
        "width": 1600,
        "height": 960,
        "min_width": 640,
        "min_height": 480,
        "url": "/",
        "devtools": false,
        "close": "stop",
        "profile_dir": {
          "argument": "--home",
          "environment": "MDO_HOME",
          "default": "mdo-home",
          "subdir": "data/cache/webview2"
        },
        "state_file": {
          "argument": "--home",
          "environment": "MDO_HOME",
          "default": "mdo-home",
          "subdir": "data/ui/main-window.state"
        },
        "install_fallback": "ask"
      }
    }
  ]
}
